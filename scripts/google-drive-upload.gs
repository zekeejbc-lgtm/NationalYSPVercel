var UPLOAD_FOLDER_ID = "1H3y_VOXOc0G1E19B0CqbLiu8d8Nxtryu";
var ALLOWED_IMAGE_MIME_TYPES = {
  "image/jpeg": true,
  "image/png": true,
  "image/gif": true,
  "image/webp": true
};
var CHECK_FILE_PREFIX = "gas-permission-check";
var DRIVE_CRUD_SECRET_PROPERTY = "DRIVE_CRUD_SECRET";
var DEFAULT_LIST_LIMIT = 50;
var MAX_LIST_LIMIT = 200;

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      throw new Error("No upload payload received.");
    }

    var data = JSON.parse(e.postData.contents);
    var action = String(data.action || "upload").toLowerCase();

    if (action === "upload") {
      return createJsonResponse(uploadImage(data));
    }

    if (action === "coalition_mail" || action === "coalition_mail_check") {
      requireCoalitionMailSecret(data.secret);
      return createJsonResponse(action === "coalition_mail" ? sendCoalitionMail(data) : setupCoalitionMailPermissions());
    }

    requireCrudSecret(data.secret);

    if (action === "delete") {
      return createJsonResponse(deleteImage(data));
    }

    if (action === "restore") {
      return createJsonResponse(restoreImage(data));
    }

    if (action === "rename" || action === "update") {
      return createJsonResponse(updateImageMetadata(data));
    }

    if (action === "replace") {
      return createJsonResponse(replaceImage(data));
    }

    if (action === "get" || action === "read") {
      return createJsonResponse(getImageMetadata(data));
    }

    if (action === "list") {
      return createJsonResponse(listImages(data));
    }

    return createJsonResponse({
      success: false,
      error: "Unsupported action: " + action
    });
  } catch (error) {
    return createJsonResponse({
      success: false,
      error: error.toString()
    });
  }
}

// Browsers convert POST redirects (302) into GET requests.
// If this is missing, the browser can throw a CORS/404 error and cancel the payload.
function doGet(e) {
  var action = e && e.parameter ? String(e.parameter.action || "") : "";
  if (action === "check" || action === "diagnostics") {
    return createJsonResponse(checkConfiguration({
      writeTest: e && e.parameter && String(e.parameter.write || "") === "1"
    }));
  }

  // The default route is a small, responsive mail console for operators.
  // Query-string API routes below remain JSON so existing integrations keep working.
  if (!action) {
    return HtmlService
      .createHtmlOutputFromFile("coalition-mail-ui")
      .setTitle("YSP Mail Console")
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  }

  try {
    if (action === "get" || action === "read") {
      requireCrudSecret(e && e.parameter ? e.parameter.secret : "");
      return createJsonResponse(getImageMetadata(e.parameter));
    }

    if (action === "list") {
      requireCrudSecret(e && e.parameter ? e.parameter.secret : "");
      return createJsonResponse(listImages(e.parameter));
    }
  } catch (error) {
    return createJsonResponse({
      success: false,
      error: error.toString()
    });
  }

  return createJsonResponse({
    success: true,
    message: "Web App is running correctly.",
    diagnosticsUrl: "?action=check",
    writeDiagnosticsUrl: "?action=check&write=1"
  });
}

// Called by the HtmlService mail console. The secret is supplied per send and
// is never persisted in the browser or Script Properties by this function.
function sendCoalitionMailFromUi(data) {
  data = data || {};
  requireCoalitionMailSecret(data.secret);
  return sendCoalitionMail(data);
}

// Run this function once manually in the Apps Script editor to grant Drive permissions.
function setupPermissions() {
  return checkConfiguration({ writeTest: true });
}

// Run once in the Apps Script editor if Google asks for the new email scope.
function setupCoalitionMailPermissions() {
  return { success: true, remainingQuota: MailApp.getRemainingDailyQuota() };
}

function requireCoalitionMailSecret(providedSecret) {
  var properties = PropertiesService.getScriptProperties();
  var expected = properties.getProperty("COALITION_MAIL_SECRET");
  // The optional bootstrap file is private, ignored by git, and generated by
  // scripts/setup-coalition-mail.ts using the server's matching secret.
  if (!expected && typeof COALITION_MAIL_BOOTSTRAP_SECRET !== "undefined") {
    expected = COALITION_MAIL_BOOTSTRAP_SECRET;
    properties.setProperty("COALITION_MAIL_SECRET", expected);
  }
  if (!expected || !providedSecret || String(providedSecret) !== expected) {
    throw new Error("Unauthorized coalition mail action.");
  }
}

function sendCoalitionMail(data) {
  var to = String(data.to || "").trim();
  var subject = String(data.subject || "").trim();
  var body = String(data.body || "");
  var messageId = String(data.messageId || "");
  if (!/^[^\s@,;]+@[^\s@,;]+\.[^\s@,;]+$/.test(to) || to.length > 254 ||
      !subject || subject.length > 120 || /[\r\n]/.test(subject) ||
      !body || body.length > 10000 || !/^[a-f0-9-]{36}$/i.test(messageId)) {
    throw new Error("Invalid coalition email payload.");
  }
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var properties = PropertiesService.getScriptProperties();
    var key = "coalition-mail-sent-" + messageId;
    if (properties.getProperty(key)) return { success: true, duplicate: true };
    if (MailApp.getRemainingDailyQuota() < 1) throw new Error("Email daily quota exhausted.");
    MailApp.sendEmail({
      to: to,
      subject: subject,
      body: body,
      htmlBody: buildCoalitionEmailHtml_(subject, body),
      name: "Youth Service Philippines"
    });
    properties.setProperty(key, String(Date.now()));
    var all = properties.getProperties();
    Object.keys(all).forEach(function(storedKey) {
      if (storedKey.indexOf("coalition-mail-sent-") === 0 && Number(all[storedKey]) < Date.now() - 2 * 86400000) {
        properties.deleteProperty(storedKey);
      }
    });
    return { success: true };
  } finally { lock.releaseLock(); }
}

